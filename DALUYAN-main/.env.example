# Public browser credentials only. Never use a secret or service-role key here.
VITE_SUPABASE_URL=
# Current Supabase projects use a publishable key for browser apps.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; use this only if your project still exposes an anon key.
VITE_SUPABASE_ANON_KEY=
# Optional Supabase Auth CAPTCHA site key; enable matching provider server-side.
VITE_TURNSTILE_SITE_KEY=
